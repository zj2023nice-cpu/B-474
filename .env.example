# ===== 数据库配置 =====
# MySQL root 用户密码
MYSQL_ROOT_PASSWORD=3434
# MySQL 数据库名
MYSQL_DATABASE=lab_db
# MySQL 宿主机映射端口
DB_PORT=3307

# ===== 后端配置 =====
# Spring 数据源连接 URL（Docker 环境下默认指向 db 容器）
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/lab_db?useSSL=false&serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&allowPublicKeyRetrieval=true
# 数据库用户名
SPRING_DATASOURCE_USERNAME=root
# 数据库密码
SPRING_DATASOURCE_PASSWORD=3434
# JWT 签名密钥（生产环境请务必修改为复杂随机字符串）
JWT_SECRET=lab-equipment-management-system-secret-key-2024-secure
# JWT 过期时间（毫秒），默认 24 小时
JWT_EXPIRATION_MS=86400000
# 后端服务宿主机映射端口
BACKEND_PORT=8080

# ===== 前端配置 =====
# 前端服务宿主机映射端口
FRONTEND_PORT=3000
